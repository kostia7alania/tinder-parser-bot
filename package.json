{
  "version": "0.0.1",
  "name": "tinder-parser-bot",
  "displayName": "Tinder Web Automation and Scraper",
  "description": "Tinder Profile Data Scraper",
  "private": false,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/kostia7alania/tinder-parser-bot"
  },
  "scripts": {
    "build": "npm run build:chrome && npm run build:firefox",
    "build:chrome": "cross-env NODE_ENV=production vite build -c vite.chrome.config.ts",
    "build:firefox": "cross-env NODE_ENV=production vite build -c vite.firefox.config.ts",
    "dev": "concurrently \"npm run dev:chrome\" \"npm run dev:firefox\"",
    "dev:chrome": "cross-env NODE_ENV=development vite -c vite.chrome.config.ts",
    "dev:firefox": "cross-env NODE_ENV=development vite build --mode development --watch -c vite.firefox.config.ts",
    "format": "prettier --write .",
    "launch": "tsx scripts/launch.ts",
    "launch:all": "tsx scripts/launch.ts --all",
    "lint": "eslint . --fix --cache",
    "lint:manifest": "web-ext lint --pretty",
    "typecheck": "vue-tsc --noEmit"
  },
  "overrides": {
    "@crxjs/vite-plugin": "$@crxjs/vite-plugin"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-vue-next": "^0.546.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.2.0",
    "@eslint/compat": "^1.4.0",
    "@eslint/js": "^9.38.0",
    "@iconify-json/lucide": "^1.2.70",
    "@iconify-json/ph": "^1.2.2",
    "@iconify-json/svg-spinners": "^1.2.4",
    "@intlify/unplugin-vue-i18n": "^11.0.1",
    "@nuxt/ui": "^4.0.1",
    "@tailwindcss/typography": "^0.5.19",
    "@types/eslint": "^9.6.1",
    "@types/node": "^24.9.1",
    "@types/webextension-polyfill": "^0.12.4",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/compiler-sfc": "^3.5.22",
    "@vueuse/core": "^13.9.0",
    "chalk": "^5.6.2",
    "chrome-types": "^0.1.383",
    "commander": "^14.0.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "dotenv": "^17.2.3",
    "eslint": "^9.38.0",
    "eslint-plugin-vue": "^10.5.1",
    "get-installed-browsers": "^0.1.7",
    "globals": "^16.4.0",
    "marked": "^16.4.1",
    "pinia": "^3.0.3",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.14",
    "terser": "^5.44.0",
    "tsx": "^4.20.6",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.1",
    "unplugin-imagemin": "^0.6.9",
    "unplugin-turbo-console": "^2.2.0",
    "unplugin-vue-router": "^0.16.0",
    "vite": "^7.1.10",
    "vite-plugin-vue-devtools": "^8.0.3",
    "vite-plugin-zip-pack": "^1.2.4",
    "vue": "^3.5.22",
    "vue-i18n": "^11.1.12",
    "vue-router": "^4.6.3",
    "vue-tsc": "^3.1.1",
    "web-ext": "^9.0.0",
    "webext-bridge": "^6.0.1",
    "webextension-polyfill": "^0.12.0"
  }
}